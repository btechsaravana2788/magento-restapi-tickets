{
  "info": {
    "_postman_id": "b38fbd57-44de-4dfc-a902-2cf14f5e2da6",
    "name": "Magento Support Ticket API",
    "description": "Customer and staff requests for MagentoTickets_SupportTicketApi. Configure collection variables before use. Token requests save tokens automatically; customer requests are scoped to the logged-in customer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://shop.example.com/rest/default/V1"
    },
    {
      "key": "customerEmail",
      "value": "customer@example.com"
    },
    {
      "key": "customerPassword",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": "123"
    },
    {
      "key": "ticketId",
      "value": "456"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get customer token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer token returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.collectionVariables.set('customerToken', pm.response.text().replace(/^\"|\"$/g, ''));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/integration/customer/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "integration",
                "customer",
                "token"
              ]
            }
          }
        },
        {
          "name": "Get admin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin token returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.collectionVariables.set('adminToken', pm.response.text().replace(/^\"|\"$/g, ''));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/integration/admin/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "integration",
                "admin",
                "token"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Create ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ticket created', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const ticket = pm.response.json();",
                  "    if (ticket.ticket_id) pm.collectionVariables.set('ticketId', String(ticket.ticket_id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"subject\": \"Question about my order\",\n  \"message\": \"Could you share the delivery estimate?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/support-tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support-tickets"
              ]
            }
          }
        },
        {
          "name": "List my tickets",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/support-tickets?searchCriteria[pageSize]=20&searchCriteria[currentPage]=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support-tickets"
              ],
              "query": [
                {
                  "key": "searchCriteria[pageSize]",
                  "value": "20"
                },
                {
                  "key": "searchCriteria[currentPage]",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get ticket",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/support-tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support-tickets",
                "{{ticketId}}"
              ]
            }
          }
        },
        {
          "name": "Add customer reply",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I have another detail to add.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/support-tickets/{{ticketId}}/replies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support-tickets",
                "{{ticketId}}",
                "replies"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Staff",
      "item": [
        {
          "name": "Advance status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/support-tickets/{{ticketId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support-tickets",
                "{{ticketId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Update priority",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"high\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/support-tickets/{{ticketId}}/priority",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support-tickets",
                "{{ticketId}}",
                "priority"
              ]
            }
          }
        },
        {
          "name": "Add staff reply (emails customer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Your order is on its way. We will send tracking details shortly.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/support-tickets/{{ticketId}}/replies/staff",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "support-tickets",
                "{{ticketId}}",
                "replies",
                "staff"
              ]
            }
          }
        }
      ]
    }
  ]
}
